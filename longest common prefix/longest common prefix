#include <stdio.h>
#include <stdlib.h>
#include <string.h>

char* longestCommonPrefix(char** strs, int strsSize) {
    if (strsSize == 0) {
        char* result = (char*)malloc(1);
        result[0] = '\0';
        return result;
    }

    // Loop through each character index of the first string
    for (int i = 0; strs[0][i] != '\0'; i++) {
        char currentChar = strs[0][i];

        // Compare currentChar with the character at index 'i' in all other strings
        for (int j = 1; j < strsSize; j++) {
            // If we hit the end of a string or find a mismatch
            if (strs[j][i] == '\0' || strs[j][i] != currentChar) {
                // Allocate memory for the resulting prefix + null terminator
                char* result = (char*)malloc(i + 1);
                strncpy(result, strs[0], i);
                result[i] = '\0';
                return result;
            }
        }
    }

    // If the loop finishes, the entire first string is the common prefix
    int len = strlen(strs[0]);
    char* result = (char*)malloc(len + 1);
    strcpy(result, strs[0]);
    return result;
}
