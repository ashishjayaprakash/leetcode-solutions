#include <stdbool.h>
#include <string.h>

bool isAnagram(char* s, char* t) {
    int len_s = strlen(s);
    int len_t = strlen(t);

    // If lengths differ, they cannot be anagrams
    if (len_s != len_t) {
        return false;
    }

    // Frequency array for 26 lowercase English letters initialized to 0
    int count[26] = {0};

    for (int i = 0; i < len_s; i++) {
        count[s[i] - 'a']++;
        count[t[i] - 'a']--;
    }

    // If any frequency is non-zero, they are not anagrams
    for (int i = 0; i < 26; i++) {
        if (count[i] != 0) {
            return false;
        }
    }

    return true;
}
