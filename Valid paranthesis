#include <stdbool.h>
#include <string.h>
#include <stdlib.h>

bool isValid(char* s) {
    int n = strlen(s);
    
    // An odd length string can never have valid parentheses
    if (n % 2 != 0) {
        return false;
    }
    
    // Stack to store open brackets
    char* stack = (char*)malloc(n * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < n; i++) {
        char ch = s[i];
        
        // Push opening brackets onto the stack
        if (ch == '(' || ch == '{' || ch == '[') {
            stack[++top] = ch;
        } else {
            // If stack is empty when encountering a closing bracket, it's invalid
            if (top == -1) {
                free(stack);
                return false;
            }
            
            // Check if top of stack matches the current closing bracket
            if ((ch == ')' && stack[top] == '(') ||
                (ch == '}' && stack[top] == '{') ||
                (ch == ']' && stack[top] == '[')) {
                top--; // Pop matching open bracket
            } else {
                free(stack);
                return false;
            }
        }
    }
    
    // If top == -1, all brackets were properly matched and popped
    bool result = (top == -1);
    free(stack);
    return result;
}
